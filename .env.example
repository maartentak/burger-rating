# ---- Neon Postgres ----
# Get this from your Neon project dashboard (Connection Details -> "Pooled connection").
# When you connect Neon through the Vercel integration this is set for you automatically.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---- Google Places API (New) ----
# Create in Google Cloud Console -> APIs & Services -> Credentials.
# Enable the "Places API (New)". Restrict it to the Places API.
# This key is only ever used server-side, so it is NOT prefixed with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY="AIzaSy..."
